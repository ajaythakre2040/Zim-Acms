# ============================================================
# ZIM-ACMS Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database
TZ=Asia/Kolkata

DATABASE_URL=postgresql://postgres:zim@2026@localhost:5432/zim_acms_prod?options=-c%20timezone=Asia/Kolkata

# Session Secret (change this to a random string for security)
SESSION_SECRET=your-secret-key-change-this-to-something-random
# Server Port (default: 5000)
PORT=5000
NODE_ENV=development

--- MS SQL Database (Biometric/Bios) ---
MSSQL_USER=sa
MSSQL_PASSWORD=savior
MSSQL_SERVER=ZLL-TOS-SRV\TOS_SRV
MSSQL_DB=eBioserverNew
MSSQL_INSTANCE=ZIM_LAB
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true


